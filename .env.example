# RunVouch server configuration. Copy to .env and edit. Every variable server.py reads is
# listed here; only RUNVOUCH_ADMIN_TOKEN is required. Blank means "feature off".

# --- required ---
# Protects /admin/* (creating accounts and API keys). Generate one: openssl rand -hex 24
RUNVOUCH_ADMIN_TOKEN=change-me

# --- core ---
# SQLite file. Docker: leave as /data/runvouch.db (set in docker-compose.yml). Local: ./data/runvouch.db
RUNVOUCH_DB=./data/runvouch.db
# Directory for the daily Merkle proof files (default: <db dir>/proof/days)
#RUNVOUCH_PROOF_DIR=./data/proof/days
# URL your agents and the dashboard use to reach this server (appears in alert links and proofs)
RUNVOUCH_PUBLIC_URL=http://localhost:8787
# Comma-separated browser origins allowed to call the API (only needed if you host a separate web front end)
#RUNVOUCH_CORS=https://runvouch.example.com

# --- detectors (defaults shown) ---
#RUNVOUCH_STORM_THRESHOLD=8      # identical tool+input repeats in one run before RETRY_STORM fires
#RUNVOUCH_DRIFT_K=4.0            # MAD multiplier for DRIFT on duration / output size
#RUNVOUCH_SWEEP_SECONDS=30       # how often the background sweeper checks for MISSED / STALLED
#RUNVOUCH_ALERT_COOLDOWN=600     # seconds between repeat alerts of the same kind for the same agent
#RUNVOUCH_NO_SWEEP=              # set to 1 to disable the background sweeper (tests only)

# --- limits ---
#RUNVOUCH_RATE_PER_MIN=1500      # API requests per minute per key
#RUNVOUCH_SIGNUPS_PER_IP=5       # self-service signups per IP per day

# --- alert delivery (optional) ---
# E-mail alerts go through Resend (https://resend.com). Without a key, e-mail alerts are skipped;
# Telegram, Slack, webhooks and PagerDuty are configured per account and need nothing here.
#RESEND_API_KEY=
#ALERT_FROM=RunVouch alerts <alerts@your-domain.example>
#BILLING_FROM=RunVouch <hello@your-domain.example>

# --- "Add to Slack" OAuth button (optional; plain Slack webhook URLs work without this) ---
#SLACK_CLIENT_ID=
#SLACK_CLIENT_SECRET=

# --- verifiable runs: OpenTimestamps (optional) ---
# Path to the `ots` client. Without it, day roots are still chained and published; only the Bitcoin stamp is skipped.
#RUNVOUCH_OTS=~/.local/bin/ots

# --- billing webhooks (hosted service only; leave blank when self-hosting) ---
#LS_WEBHOOK_SECRET=
#LS_VARIANT_PLANS=              # "variant-id:solo,variant-id:team"
#STRIPE_WEBHOOK_SECRET=
#STRIPE_PRICE_PLANS=            # "price_x:solo,price_y:team"
#POLAR_WEBHOOK_SECRET=
#POLAR_PRODUCT_PLANS=           # "product-uuid:solo,product-uuid:team"
