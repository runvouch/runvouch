[Unit]
Description=RunVouch push watch (keeps GitHub level with this machine, tests must be green)
[Service]
Type=oneshot
WorkingDirectory=%h/runvouch
ExecStart=%h/bin/rv run pushwacht --source systemd --log %h/runvouch/data/pushwacht.log -- %h/runvouch/.venv/bin/python %h/runvouch/deploy/pushwacht.py
