{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "com.runvouch/runvouch",
  "description": "The watchdog for unattended AI agents: agent health, alerts, run reports with evidence and cost.",
  "version": "0.3.3",
  "websiteUrl": "https://runvouch.com/docs/mcp",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.runvouch.com/mcp",
      "headers": [
        {
          "name": "X-API-Key",
          "description": "RunVouch API key (free at runvouch.com)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/runvouch/runvouch",
    "source": "github"
  }
}