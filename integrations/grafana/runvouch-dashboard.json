{
  "__inputs": [
    {
      "name": "DS_RUNVOUCH",
      "label": "RunVouch (Infinity)",
      "description": "Infinity datasource with an X-API-Key header for the /v1/ panels",
      "type": "datasource",
      "pluginId": "yesoreyeram-infinity-datasource",
      "pluginName": "Infinity"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "yesoreyeram-infinity-datasource", "name": "Infinity", "version": "2.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "title": "RunVouch agents",
  "uid": "runvouch-agents",
  "description": "RunVouch agent state, open alerts and RunVouch API uptime. Panels read api.runvouch.com through the Infinity datasource.",
  "tags": ["runvouch", "agents", "cron"],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "api",
        "label": "RunVouch API",
        "type": "textbox",
        "query": "https://api.runvouch.com",
        "current": { "text": "https://api.runvouch.com", "value": "https://api.runvouch.com" },
        "hide": 0
      },
      {
        "name": "fleet",
        "label": "Public fleet slug (optional)",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row", "title": "Your agents (X-API-Key on the datasource)", "id": 1, "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat", "title": "Agents not ok", "id": 2,
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_RUNVOUCH}" },
      "targets": [{
        "refId": "A", "type": "json", "source": "url", "format": "table", "parser": "backend",
        "url": "${api}/v1/agents", "url_options": { "method": "GET" },
        "root_selector": "",
        "columns": [
          { "selector": "name", "text": "agent", "type": "string" },
          { "selector": "state", "text": "state", "type": "string" }
        ],
        "filterExpression": "state != 'ok' && state != 'paused'"
      }],
      "options": { "reduceOptions": { "calcs": ["count"], "fields": "/^agent$/", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] }
    },
    {
      "type": "stat", "title": "Open alerts", "id": 3,
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_RUNVOUCH}" },
      "targets": [{
        "refId": "A", "type": "json", "source": "url", "format": "table", "parser": "backend",
        "url": "${api}/v1/alerts", "url_options": { "method": "GET" },
        "root_selector": "",
        "columns": [ { "selector": "kind", "text": "kind", "type": "string" } ]
      }],
      "options": { "reduceOptions": { "calcs": ["count"], "fields": "/^kind$/", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] } }, "overrides": [] }
    },
    {
      "type": "stat", "title": "Cost last 24 h (USD)", "id": 4,
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_RUNVOUCH}" },
      "targets": [{
        "refId": "A", "type": "json", "source": "url", "format": "table", "parser": "backend",
        "url": "${api}/v1/agents", "url_options": { "method": "GET" },
        "root_selector": "",
        "columns": [ { "selector": "cost_24h", "text": "cost_24h", "type": "number" } ]
      }],
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "/^cost_24h$/", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] }
    },
    {
      "type": "stat", "title": "RunVouch detector heartbeat age", "id": 5,
      "description": "Seconds since RunVouch's own detector loop last ran (public status.json). Above 150 s your MISSED alerts are late.",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_RUNVOUCH}" },
      "targets": [{
        "refId": "A", "type": "json", "source": "url", "format": "table", "parser": "backend",
        "url": "${api}/status.json", "url_options": { "method": "GET" },
        "root_selector": "",
        "columns": [ { "selector": "last_heartbeat_age_s", "text": "age", "type": "number" } ]
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 150 }, { "color": "red", "value": 300 } ] } }, "overrides": [] }
    },
    {
      "type": "table", "title": "Agents", "id": 6,
      "gridPos": { "h": 10, "w": 14, "x": 0, "y": 6 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_RUNVOUCH}" },
      "targets": [{
        "refId": "A", "type": "json", "source": "url", "format": "table", "parser": "backend",
        "url": "${api}/v1/agents", "url_options": { "method": "GET" },
        "root_selector": "",
        "columns": [
          { "selector": "name", "text": "agent", "type": "string" },
          { "selector": "state", "text": "state", "type": "string" },
          { "selector": "cadence_s", "text": "cadence (s)", "type": "number" },
          { "selector": "open_alerts", "text": "open alerts", "type": "number" },
          { "selector": "cost_24h", "text": "cost 24h", "type": "number" },
          { "selector": "last_run.started", "text": "last start", "type": "timestamp_epoch_s" },
          { "selector": "last_run.status", "text": "last status", "type": "string" },
          { "selector": "last_run.evidence_ok", "text": "evidence", "type": "boolean" }
        ]
      }],
      "options": { "showHeader": true, "sortBy": [ { "displayName": "state", "desc": true } ] },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "state" }, "properties": [
            { "id": "custom.cellOptions", "value": { "type": "color-background" } },
            { "id": "mappings", "value": [ { "type": "value", "options": {
              "ok": { "color": "green", "index": 0 },
              "running": { "color": "blue", "index": 1 },
              "waiting": { "color": "text", "index": 2 },
              "paused": { "color": "text", "index": 3 },
              "unproven": { "color": "orange", "index": 4 },
              "failed": { "color": "red", "index": 5 },
              "alert": { "color": "red", "index": 6 } } } ] } ] },
          { "matcher": { "id": "byName", "options": "cost 24h" }, "properties": [ { "id": "unit", "value": "currencyUSD" }, { "id": "decimals", "value": 2 } ] }
        ]
      }
    },
    {
      "type": "table", "title": "Open alerts", "id": 7,
      "gridPos": { "h": 10, "w": 10, "x": 14, "y": 6 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_RUNVOUCH}" },
      "targets": [{
        "refId": "A", "type": "json", "source": "url", "format": "table", "parser": "backend",
        "url": "${api}/v1/alerts", "url_options": { "method": "GET" },
        "root_selector": "",
        "columns": [
          { "selector": "ts", "text": "when", "type": "timestamp_epoch_s" },
          { "selector": "kind", "text": "kind", "type": "string" },
          { "selector": "agent", "text": "agent", "type": "string" },
          { "selector": "message", "text": "message", "type": "string" }
        ]
      }],
      "options": { "showHeader": true, "sortBy": [ { "displayName": "when", "desc": true } ] },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "type": "row", "title": "Public fleet (no key; set the fleet variable)", "id": 8, "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }
    },
    {
      "type": "table", "title": "Fleet $fleet", "id": 9,
      "description": "Public status of an opted-in fleet: only agents the owner marked public, only run facts.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_RUNVOUCH}" },
      "targets": [{
        "refId": "A", "type": "json", "source": "url", "format": "table", "parser": "backend",
        "url": "${api}/public/fleet/${fleet}.json", "url_options": { "method": "GET" },
        "root_selector": "agents",
        "columns": [
          { "selector": "label", "text": "agent", "type": "string" },
          { "selector": "kind", "text": "kind", "type": "string" },
          { "selector": "cadence_s", "text": "cadence (s)", "type": "number" },
          { "selector": "late", "text": "late", "type": "boolean" },
          { "selector": "last_run.started", "text": "last start", "type": "timestamp_epoch_s" },
          { "selector": "last_run.status", "text": "last status", "type": "string" },
          { "selector": "rates.7d.runs", "text": "runs 7d", "type": "number" },
          { "selector": "rates.7d.ok", "text": "ok 7d", "type": "number" },
          { "selector": "open_alert.kind", "text": "open alert", "type": "string" }
        ]
      }],
      "options": { "showHeader": true },
      "fieldConfig": { "defaults": {}, "overrides": [
        { "matcher": { "id": "byName", "options": "late" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "color-background" } }, { "id": "mappings", "value": [ { "type": "value", "options": { "true": { "color": "red", "index": 0 }, "false": { "color": "green", "index": 1 } } } ] } ] }
      ] }
    },
    {
      "type": "row", "title": "RunVouch itself (public status.json)", "id": 10, "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 }
    },
    {
      "type": "stat", "title": "Detector uptime", "id": 11,
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 27 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_RUNVOUCH}" },
      "targets": [{
        "refId": "A", "type": "json", "source": "url", "format": "table", "parser": "backend",
        "url": "${api}/status.json", "url_options": { "method": "GET" },
        "root_selector": "",
        "columns": [
          { "selector": "windows.24h.detectors", "text": "24h", "type": "number" },
          { "selector": "windows.7d.detectors", "text": "7d", "type": "number" },
          { "selector": "windows.30d.detectors", "text": "30d", "type": "number" },
          { "selector": "windows.90d.detectors", "text": "90d", "type": "number" }
        ]
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 99 }, { "color": "green", "value": 99.9 } ] } }, "overrides": [] }
    },
    {
      "type": "table", "title": "Incidents (last 10)", "id": 12,
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 27 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_RUNVOUCH}" },
      "targets": [{
        "refId": "A", "type": "json", "source": "url", "format": "table", "parser": "backend",
        "url": "${api}/status.json", "url_options": { "method": "GET" },
        "root_selector": "incidents",
        "columns": [
          { "selector": "start", "text": "start (UTC)", "type": "string" },
          { "selector": "minutes", "text": "minutes", "type": "number" },
          { "selector": "component", "text": "component", "type": "string" },
          { "selector": "ongoing", "text": "ongoing", "type": "boolean" }
        ]
      }],
      "options": { "showHeader": true },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    }
  ]
}
